// Prisma schema: https://pris.ly/d/prisma-schema
// The connection URL lives in prisma.config.ts (Prisma 7).
// Naming: camelCase in TypeScript, snake_case in PostgreSQL (@map / @@map).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  // Explicit, not inferred from tsconfig.json: the Docker build generates the client before
  // tsconfig.json is copied in, and the inferred default (".ts") breaks the compiled imports.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum StripeEventStatus {
  PENDING
  PROCESSED
  FAILED
  /// Settled by a reconciliation repair (stage 7), not by processing the event itself.
  RECONCILED

  @@map("stripe_event_status")
}

/// Inbox of webhook events from Stripe. Stored first, processed later by the worker (stage 5).
model StripeEvent {
  /// Stripe's own event ID (evt_...). As the primary key it makes the database reject a duplicate
  /// delivery of the same event, even when two copies arrive at the same moment.
  id              String            @id
  /// Event type, e.g. checkout.session.completed
  type            String
  /// The event's ID, type and time and the IDs the worker reads (src/webhooks/stored-payload.ts).
  /// The rest, including customer details, is never stored; the worker fetches it from Stripe.
  payload         Json
  status          StripeEventStatus @default(PENDING)
  attempts        Int               @default(0)
  lastError       String?           @map("last_error")
  /// When Stripe created the event (event.created); events can arrive out of order.
  stripeCreatedAt DateTime          @map("stripe_created_at") @db.Timestamptz(3)
  /// Always the database's clock: Prisma fills `now()` from the app's clock, so a trigger
  /// (migration 20261019181445_stripe_events_received_at_trigger) overwrites it on insert. Repairs
  /// compare it with the database's clock to know which events their Stripe snapshot covers.
  receivedAt      DateTime          @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?         @map("processed_at") @db.Timestamptz(3)

  @@map("stripe_events")
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  /// Checkout session expired before payment (checkout.session.expired).
  EXPIRED

  @@map("order_status")
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  /// Payment intent canceled before it succeeded (payment_intent.canceled).
  CANCELED

  @@map("payment_status")
}

/// Mirrors Stripe's refund statuses (requires_action is treated as PENDING).
enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED

  @@map("refund_status")
}

/// A customer's purchase. Created as PENDING before checkout (stage 3), updated by the worker.
model Order {
  /// Generated by PostgreSQL; random, so it doesn't reveal how many orders exist.
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status                  OrderStatus @default(PENDING)
  /// Smallest currency unit (cents). Integers, never floats: no rounding errors.
  amount                  Int
  /// Three-letter ISO code in lowercase, as Stripe sends it (e.g. usd).
  currency                String      @db.Char(3)
  /// Course bought, from the catalog in src/checkout/catalog.ts. Needed to grant access and report sales per course.
  courseId                String      @map("course_id")
  customerEmail           String?     @map("customer_email")
  /// Unique so a repeated checkout.session.completed event finds the same order.
  stripeCheckoutSessionId String?     @unique @map("stripe_checkout_session_id")
  /// When the last saved Stripe snapshot for this order started reading Stripe (database clock). A job
  /// whose read started earlier must not overwrite it, so it reads Stripe again. Null until the first.
  syncedAt                DateTime?   @map("synced_at") @db.Timestamptz(3)
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  payments                Payment[]

  @@map("orders")
}

/// One payment attempt for an order. An order can have several (a failed card, then a good one).
model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  /// Restrict: payment records must never disappear because an order was deleted.
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Unique so processing the same event twice updates this row instead of adding a duplicate.
  stripePaymentIntentId String        @unique @map("stripe_payment_intent_id")
  /// Smallest currency unit (cents).
  amount                Int
  currency              String        @db.Char(3)
  status                PaymentStatus
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  refunds               Refund[]

  /// PostgreSQL does not index foreign keys automatically; "payments of this order" needs one.
  @@index([orderId])
  @@map("payments")
}

/// A full or partial refund of a payment.
model Refund {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId      String       @map("payment_id") @db.Uuid
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  stripeRefundId String       @unique @map("stripe_refund_id")
  /// Smallest currency unit (cents); positive, even though money goes back to the customer.
  amount         Int
  currency       String       @db.Char(3)
  status         RefundStatus
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([paymentId])
  @@map("refunds")
}

/// A paid Checkout Session that reconciliation can't repair (e.g. its amount doesn't match the order).
/// Recorded once by the worker; later runs skip it until someone sets resolved_at.
model ReconciliationIssue {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique: one open or resolved issue per session; a repeat failure updates it.
  stripeCheckoutSessionId String    @unique @map("stripe_checkout_session_id")
  /// No foreign key: the issue may be that the order doesn't exist.
  orderId                 String?   @map("order_id") @db.Uuid
  /// The repair's error message.
  reason                  String
  firstSeenAt             DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt              DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Null while open. Set it (SQL for now) once fixed; the next run then tries the session again.
  resolvedAt              DateTime? @map("resolved_at") @db.Timestamptz(3)

  @@map("reconciliation_issues")
}
