// Prisma schema: https://pris.ly/d/prisma-schema
// The connection URL lives in prisma.config.ts (Prisma 7).
// Naming: camelCase in TypeScript, snake_case in PostgreSQL (@map / @@map).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum StripeEventStatus {
  PENDING
  PROCESSED
  FAILED

  @@map("stripe_event_status")
}

/// Inbox of webhook events from Stripe. Stored first, processed later by the worker (stage 5).
model StripeEvent {
  /// Stripe's own event ID (evt_...). As the primary key it makes the database reject a duplicate
  /// delivery of the same event, even when two copies arrive at the same moment.
  id              String            @id
  /// Event type, e.g. checkout.session.completed
  type            String
  /// The full event as Stripe sent it, kept for debugging and replays.
  payload         Json
  status          StripeEventStatus @default(PENDING)
  attempts        Int               @default(0)
  lastError       String?           @map("last_error")
  /// When Stripe created the event (event.created); events can arrive out of order.
  stripeCreatedAt DateTime          @map("stripe_created_at") @db.Timestamptz(3)
  receivedAt      DateTime          @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt     DateTime?         @map("processed_at") @db.Timestamptz(3)

  @@map("stripe_events")
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  /// Checkout session expired before payment (checkout.session.expired).
  EXPIRED

  @@map("order_status")
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  /// Payment intent canceled before it succeeded (payment_intent.canceled).
  CANCELED

  @@map("payment_status")
}

/// Mirrors Stripe's refund statuses (requires_action is treated as PENDING).
enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED

  @@map("refund_status")
}

/// A customer's purchase. Created as PENDING before checkout (stage 3), updated by the worker.
model Order {
  /// Generated by PostgreSQL; random, so it doesn't reveal how many orders exist.
  id                      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status                  OrderStatus @default(PENDING)
  /// Smallest currency unit (cents). Integers, never floats: no rounding errors.
  amount                  Int
  /// Three-letter ISO code in lowercase, as Stripe sends it (e.g. usd).
  currency                String      @db.Char(3)
  customerEmail           String?     @map("customer_email")
  /// Unique so a repeated checkout.session.completed event finds the same order.
  stripeCheckoutSessionId String?     @unique @map("stripe_checkout_session_id")
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  payments                Payment[]

  @@map("orders")
}

/// One payment attempt for an order. An order can have several (a failed card, then a good one).
model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  /// Restrict: payment records must never disappear because an order was deleted.
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// Unique so processing the same event twice updates this row instead of adding a duplicate.
  stripePaymentIntentId String        @unique @map("stripe_payment_intent_id")
  /// Smallest currency unit (cents).
  amount                Int
  currency              String        @db.Char(3)
  status                PaymentStatus
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  refunds               Refund[]

  /// PostgreSQL does not index foreign keys automatically; "payments of this order" needs one.
  @@index([orderId])
  @@map("payments")
}

/// A full or partial refund of a payment.
model Refund {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId      String       @map("payment_id") @db.Uuid
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  stripeRefundId String       @unique @map("stripe_refund_id")
  /// Smallest currency unit (cents); positive, even though money goes back to the customer.
  amount         Int
  currency       String       @db.Char(3)
  status         RefundStatus
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([paymentId])
  @@map("refunds")
}
