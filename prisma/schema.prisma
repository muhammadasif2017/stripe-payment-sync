// Prisma schema: https://pris.ly/d/prisma-schema
// Tables arrive in stage 2. The connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}
