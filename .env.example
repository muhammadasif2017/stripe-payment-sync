# Copy to .env and fill in. Never commit .env.

# --- Docker Compose (local PostgreSQL and Redis) ---
POSTGRES_USER=payments
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payments
POSTGRES_PORT=5435
REDIS_PORT=6380

# --- App ---
PORT=3000
# Public address of this app; Stripe sends customers back here after checkout (no trailing slash)
APP_URL=http://localhost:3000
# false = API only; run another process with true (the default) to process Stripe events
WORKER_ENABLED=true
# Login for the queue dashboard at /admin/queues (HTTP Basic auth). The password needs 16+ characters;
# generate one with: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-16-or-more-characters
DATABASE_URL=postgresql://payments:change-me@localhost:5435/payments
REDIS_URL=redis://localhost:6380

# --- Tests ---
# Separate database for `npm run test:e2e`, created and migrated automatically. Tests insert and
# delete rows here; it must not be the same database as DATABASE_URL.
TEST_DATABASE_URL=postgresql://payments:change-me@localhost:5435/payments_test
# Separate Redis database (number 1) for the e2e tests; they empty the queues they use.
TEST_REDIS_URL=redis://localhost:6380/1
# Only for a throwaway database on another machine (e.g. a CI service); local is the default.
# ALLOW_REMOTE_TEST_DATABASE=true

# Stripe test mode only: the app rejects keys that do not start with sk_test_
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by `stripe listen` (stage 4) or shown in the Stripe dashboard webhook settings
STRIPE_WEBHOOK_SECRET=whsec_replace_me
